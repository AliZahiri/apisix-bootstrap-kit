# runIT.sh generates a private .env with unique API keys on first use.
# Do not use placeholder keys on a shared host.
APISIX_ADMIN_KEY=replace-with-a-unique-random-hex-secret
APISIX_VIEWER_KEY=replace-with-a-different-random-hex-secret
APISIX_IMAGE_TAG=3.19.0-debian
APISIX_HTTP_PORT=8080
APISIX_HTTPS_PORT=8443
APISIX_ADMIN_PORT=9180
APISIX_METRICS_PORT=9091
