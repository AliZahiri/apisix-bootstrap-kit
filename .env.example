# Dashboard JWT secret for API access
DASHBOARD_JWT_SECRET=changeme_secret_string

# Dashboard login users
DASHBOARD_ADMIN_PASS=changeme_admin_pass
DASHBOARD_VIEWER_PASS=changeme_viewer_pass

# APISIX Admin Keys (for apisix_cnf.sample.yml)
APISIX_ADMIN_KEY=changeme_admin_key
APISIX_VIEWER_KEY=changeme_viewer_key
